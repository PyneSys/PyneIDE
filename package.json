{
  "name": "pyneide",
  "displayName": "PyneIDE",
  "description": "Pine Script and Pyne in VS Code: highlighting, completion and inline diagnostics for .pine files, a step-through Pine debugger, one-click compile and run, and an interactive backtest chart. Pine Script is a trademark of TradingView; PyneIDE is not a TradingView product and is not affiliated with TradingView.",
  "version": "0.1.0",
  "preview": true,
  "publisher": "pynesys",
  "icon": "icon.png",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Linters",
    "Visualization",
    "Snippets"
  ],
  "galleryBanner": {
    "color": "#1A1B1C",
    "theme": "dark"
  },
  "keywords": [
    "pine script",
    "pinescript",
    "pyne",
    "pynecore",
    "trading",
    "indicators",
    "strategies",
    "backtesting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PyneSys/PyneIDE"
  },
  "bugs": {
    "url": "https://github.com/PyneSys/PyneIDE/issues"
  },
  "homepage": "https://pynesys.io",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:pine",
    "onDebugDynamicConfigurations:pyne",
    "onCustomEditor:pyneide.ohlcvTable"
  ],
  "contributes": {
    "configurationDefaults": {
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.expand": false,
      "explorer.fileNesting.patterns": {
        "*.pine": "${capture}.py, ${capture}.py.map, ${capture}.toml",
        "*.py": "${capture}.py.map, ${capture}.toml",
        "*.ohlcv": "${capture}.toml",
        "*.csv": "${capture}_viz.ndjson, ${capture}_strat.csv, ${capture}_trade.csv"
      },
      "workbench.editor.customLabels.patterns": {
        "**/scripts/lib/*/*/v*.{pine,py}": "${dirname}/${filename}.${extname}"
      }
    },
    "commands": [
      {
        "command": "pyneide.setupEnvironment",
        "title": "Setup Environment",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.createWorkspace",
        "title": "Initialize Pyne Project",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.openWalkthrough",
        "title": "Get Started",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.showEnvironmentLog",
        "title": "Show Environment Log",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.reportProblem",
        "title": "Report a Problem",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.environmentMenu",
        "title": "Environment Menu",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.signIn",
        "title": "Sign In to PyneSys",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.signOut",
        "title": "Sign Out from PyneSys",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pineLsInstall",
        "title": "Install / Update Pine Language Server",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pineLsRestart",
        "title": "Restart Pine Language Server",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pineLsShowLog",
        "title": "Show Pine Language Server Log",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pyrightRestart",
        "title": "Restart Pyne Typing (pyright)",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pyrightShowLog",
        "title": "Show Pyne Typing Log",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.usePyneAnalysis",
        "title": "Use PyneIDE for Python Analysis (instead of Pylance)",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.compilePine",
        "title": "Compile Pine Script",
        "category": "PyneIDE",
        "enablement": "editorLangId == pine"
      },
      {
        "command": "pyneide.convertToV6",
        "title": "Convert Pine to v6",
        "category": "PyneIDE",
        "enablement": "editorLangId == pine"
      },
      {
        "command": "pyneide.showUsage",
        "title": "Show Compile Usage",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.toggleStrictCompile",
        "title": "Toggle Strict Compilation",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.runScript",
        "title": "Run Pyne code",
        "category": "PyneIDE",
        "icon": "$(play)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      },
      {
        "command": "pyneide.debugScript",
        "title": "Debug Pyne code",
        "category": "PyneIDE",
        "icon": "$(debug-alt)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      },
      {
        "command": "pyneide.runPineScript",
        "title": "Run Pine Script",
        "category": "PyneIDE",
        "icon": "$(play)",
        "enablement": "resourceLangId == pine"
      },
      {
        "command": "pyneide.debugPineScript",
        "title": "Debug Pine Script",
        "category": "PyneIDE",
        "icon": "$(debug-alt)",
        "enablement": "resourceLangId == pine"
      },
      {
        "command": "pyneide.changeRunData",
        "title": "Select Data…",
        "category": "PyneIDE",
        "icon": "$(graph-line)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      },
      {
        "command": "pyneide.openChart",
        "title": "Open Chart",
        "category": "PyneIDE",
        "icon": "$(graph)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      },
      {
        "command": "pyneide.selectBreakpointBar",
        "title": "Choose Bar on Chart…",
        "category": "PyneIDE",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      },
      {
        "command": "pyneide.toggleChartFullscreen",
        "title": "Toggle Chart Fullscreen",
        "category": "PyneIDE",
        "icon": "$(screen-full)"
      },
      {
        "command": "pyneide.pauseRun",
        "title": "Pause Run at Next Bar",
        "category": "PyneIDE",
        "enablement": "pyneide.runActive && !pyneide.runPaused"
      },
      {
        "command": "pyneide.resumeRun",
        "title": "Resume Run",
        "category": "PyneIDE",
        "enablement": "pyneide.runPaused"
      },
      {
        "command": "pyneide.stepBar",
        "title": "Next Bar",
        "category": "PyneIDE",
        "icon": "$(triangle-right)",
        "enablement": "pyneide.runActive"
      },
      {
        "command": "pyneide.runToBar",
        "title": "Run to Bar…",
        "category": "PyneIDE",
        "icon": "$(run-below)",
        "enablement": "pyneide.runActive"
      },
      {
        "command": "pyneide.cancelRun",
        "title": "Stop Run",
        "category": "PyneIDE",
        "icon": "$(debug-stop)",
        "enablement": "pyneide.runActive"
      },
      {
        "command": "pyneide.runControlMenu",
        "title": "Run Controls",
        "category": "PyneIDE",
        "enablement": "pyneide.runActive"
      },
      {
        "command": "pyneide.workspace.refresh",
        "title": "Refresh",
        "category": "PyneIDE",
        "icon": "$(refresh)"
      },
      {
        "command": "pyneide.workspace.createScript",
        "title": "New Script…",
        "category": "PyneIDE",
        "icon": "$(add)"
      },
      {
        "command": "pyneide.dataDownloadWizard",
        "title": "Download Data…",
        "category": "PyneIDE",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pyneide.openSymbolBrowser",
        "title": "Open Symbol Browser",
        "category": "PyneIDE",
        "icon": "$(search)"
      },
      {
        "command": "pyneide.openPlugins",
        "title": "Manage Plugins",
        "category": "PyneIDE",
        "icon": "$(extensions)"
      },
      {
        "command": "pyneide.editSymbolMap",
        "title": "Edit Symbol Map",
        "category": "PyneIDE",
        "icon": "$(list-tree)"
      },
      {
        "command": "pyneide.openSymbolMap",
        "title": "Open Symbol Map",
        "category": "PyneIDE",
        "icon": "$(references)"
      },
      {
        "command": "pyneide.showDataRequirements",
        "title": "Show Data Requirements",
        "category": "PyneIDE",
        "icon": "$(checklist)"
      },
      {
        "command": "pyneide.workspace.runScript",
        "title": "Run Pyne code",
        "category": "PyneIDE",
        "icon": "$(play)"
      },
      {
        "command": "pyneide.workspace.debugScript",
        "title": "Debug Pyne code",
        "category": "PyneIDE",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pyneide.workspace.runPineScript",
        "title": "Run Pine Script",
        "category": "PyneIDE",
        "icon": "$(play)"
      },
      {
        "command": "pyneide.workspace.debugPineScript",
        "title": "Debug Pine Script",
        "category": "PyneIDE",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pyneide.workspace.selectData",
        "title": "Select Data…",
        "category": "PyneIDE",
        "icon": "$(graph-line)"
      },
      {
        "command": "pyneide.workspace.openTable",
        "title": "Open as Table",
        "category": "PyneIDE",
        "icon": "$(table)"
      },
      {
        "command": "pyneide.dataUpdate",
        "title": "Update (continue)",
        "category": "PyneIDE",
        "icon": "$(sync)"
      },
      {
        "command": "pyneide.dataTruncate",
        "title": "Truncate & Re-download…",
        "category": "PyneIDE",
        "icon": "$(trash)"
      },
      {
        "command": "pyneide.dataDownloadTimeframe",
        "title": "Download Other Timeframe…",
        "category": "PyneIDE",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pyneide.dataPreviewChart",
        "title": "Preview Chart",
        "category": "PyneIDE",
        "icon": "$(graph)"
      },
      {
        "command": "pyneide.dataDelete",
        "title": "Delete Data…",
        "category": "PyneIDE",
        "icon": "$(trash)"
      },
      {
        "command": "pyneide.scriptDelete",
        "title": "Delete",
        "category": "PyneIDE",
        "icon": "$(trash)"
      },
      {
        "command": "pyneide.outputDelete",
        "title": "Delete",
        "category": "PyneIDE",
        "icon": "$(trash)"
      },
      {
        "command": "pyneide.workspace.openOutputChart",
        "title": "Open Chart",
        "category": "PyneIDE",
        "icon": "$(graph)"
      },
      {
        "command": "pyneide.workspace.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.editInputs",
        "title": "Edit Inputs…",
        "category": "PyneIDE",
        "icon": "$(settings-gear)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine || pyneide.chartHasInputs"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pyneide.convertToV6",
          "when": "resourceLangId == pine && pyneide.canConvertToV6"
        },
        {
          "command": "pyneide.runScript",
          "when": "resourceLangId != pine"
        },
        {
          "command": "pyneide.debugScript",
          "when": "resourceLangId != pine"
        },
        {
          "command": "pyneide.runPineScript",
          "when": "resourceLangId == pine"
        },
        {
          "command": "pyneide.debugPineScript",
          "when": "resourceLangId == pine"
        },
        {
          "command": "pyneide.workspace.runScript",
          "when": "false"
        },
        {
          "command": "pyneide.workspace.debugScript",
          "when": "false"
        },
        {
          "command": "pyneide.workspace.runPineScript",
          "when": "false"
        },
        {
          "command": "pyneide.workspace.debugPineScript",
          "when": "false"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "pyneide.selectBreakpointBar",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "pyneide@1"
        }
      ],
      "editor/context": [
        {
          "command": "pyneide.compilePine",
          "when": "resourceLangId == pine",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.convertToV6",
          "when": "resourceLangId == pine && pyneide.canConvertToV6",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.runPineScript",
          "when": "resourceLangId == pine",
          "group": "pyneide@0"
        },
        {
          "command": "pyneide.runScript",
          "when": "resourceLangId != pine && pyneide.isPyneScript",
          "group": "pyneide@0"
        },
        {
          "command": "pyneide.debugPineScript",
          "when": "resourceLangId == pine",
          "group": "pyneide@2"
        },
        {
          "command": "pyneide.debugScript",
          "when": "resourceLangId != pine && pyneide.isPyneScript",
          "group": "pyneide@2"
        },
        {
          "command": "pyneide.changeRunData",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "pyneide@3"
        },
        {
          "command": "pyneide.openChart",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "pyneide@4"
        },
        {
          "command": "pyneide.editInputs",
          "when": "pyneide.isPyneScript",
          "group": "pyneide@5"
        }
      ],
      "editor/title/run": [
        {
          "command": "pyneide.cancelRun",
          "when": "(resourceLangId == pine || pyneide.isPyneScript) && pyneide.runActiveHere",
          "group": "navigation@0"
        },
        {
          "command": "pyneide.runPineScript",
          "when": "resourceLangId == pine && !pyneide.runActiveHere",
          "group": "navigation@1"
        },
        {
          "command": "pyneide.runScript",
          "when": "resourceLangId != pine && pyneide.isPyneScript && !pyneide.runActiveHere",
          "group": "navigation@1"
        },
        {
          "command": "pyneide.debugPineScript",
          "when": "resourceLangId == pine && !pyneide.runActiveHere",
          "group": "navigation@2"
        },
        {
          "command": "pyneide.debugScript",
          "when": "resourceLangId != pine && pyneide.isPyneScript && !pyneide.runActiveHere",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "pyneide.openChart",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "navigation@1"
        },
        {
          "command": "pyneide.editInputs",
          "when": "activeWebviewPanelId != pyneideChart && pyneide.isPyneScript",
          "group": "navigation@3"
        },
        {
          "command": "pyneide.editInputs",
          "when": "activeWebviewPanelId == pyneideChart && pyneide.chartHasInputs",
          "group": "navigation@-99"
        },
        {
          "command": "pyneide.toggleChartFullscreen",
          "when": "activeWebviewPanelId == pyneideChart && !editorPartMaximizedEditorGroup",
          "group": "navigation@-100"
        },
        {
          "command": "pyneide.dataPreviewChart",
          "when": "activeCustomEditorId == pyneide.ohlcvTable",
          "group": "navigation@1"
        }
      ],
      "debug/toolBar": [
        {
          "command": "pyneide.stepBar",
          "when": "debugType == pyne && pyneide.runActive",
          "group": "navigation@1"
        },
        {
          "command": "pyneide.runToBar",
          "when": "debugType == pyne && pyneide.runActive",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "pyneide.workspace.refresh",
          "when": "view == pyneide.workspace",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "pyneide.workspace.createScript",
          "when": "view == pyneide.workspace && viewItem == pyneSection.scripts",
          "group": "inline@1"
        },
        {
          "command": "pyneide.openSymbolMap",
          "when": "view == pyneide.workspace && viewItem == pyneSection.data",
          "group": "inline@1"
        },
        {
          "command": "pyneide.dataDownloadWizard",
          "when": "view == pyneide.workspace && viewItem == pyneSection.data",
          "group": "inline@2"
        },
        {
          "command": "pyneide.openSymbolMap",
          "when": "view == pyneide.workspace && viewItem == pyneSection.data",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.dataDownloadWizard",
          "when": "view == pyneide.workspace && viewItem == pyneSection.data",
          "group": "pyneide@2"
        },
        {
          "command": "pyneide.openSymbolMap",
          "when": "view == pyneide.workspace && viewItem == pyneSymbolMapRoot",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.workspace.runPineScript",
          "when": "view == pyneide.workspace && viewItem == pyneScriptPine",
          "group": "inline@1"
        },
        {
          "command": "pyneide.workspace.debugPineScript",
          "when": "view == pyneide.workspace && viewItem == pyneScriptPine",
          "group": "inline@2"
        },
        {
          "command": "pyneide.workspace.runScript",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "inline@1"
        },
        {
          "command": "pyneide.workspace.debugScript",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "inline@2"
        },
        {
          "command": "pyneide.workspace.runPineScript",
          "when": "view == pyneide.workspace && viewItem == pyneScriptPine",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.workspace.debugPineScript",
          "when": "view == pyneide.workspace && viewItem == pyneScriptPine",
          "group": "pyneide@2"
        },
        {
          "command": "pyneide.workspace.runScript",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.workspace.debugScript",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "pyneide@2"
        },
        {
          "command": "pyneide.workspace.selectData",
          "when": "view == pyneide.workspace && viewItem =~ /^pyneScript/",
          "group": "pyneide@3"
        },
        {
          "command": "pyneide.editInputs",
          "when": "view == pyneide.workspace && viewItem =~ /^pyneScript/",
          "group": "pyneide@4"
        },
        {
          "command": "pyneide.workspace.revealInExplorer",
          "when": "view == pyneide.workspace && (viewItem =~ /^pyneScript/ || viewItem == pyneLibrary || viewItem == pyneLibraryRoot || viewItem == pyneLibraryPublisher || viewItem == pyneLibraryFolder || viewItem == pyneFile)",
          "group": "9_reveal@1"
        },
        {
          "command": "pyneide.scriptDelete",
          "when": "view == pyneide.workspace && (viewItem =~ /^pyneScript/ || viewItem == pyneLibrary || viewItem == pyneLibraryRoot || viewItem == pyneLibraryPublisher || viewItem == pyneLibraryFolder || viewItem == pyneFile)",
          "group": "9_reveal@2"
        },
        {
          "command": "pyneide.dataPreviewChart",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "inline@1"
        },
        {
          "command": "pyneide.dataUpdate",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "inline@2"
        },
        {
          "command": "pyneide.dataPreviewChart",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.workspace.openTable",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "pyneide@2"
        },
        {
          "command": "pyneide.dataUpdate",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "pyneide@3"
        },
        {
          "command": "pyneide.dataTruncate",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "pyneide@4"
        },
        {
          "command": "pyneide.dataDownloadTimeframe",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "pyneide@5"
        },
        {
          "command": "pyneide.workspace.revealInExplorer",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "9_reveal@1"
        },
        {
          "command": "pyneide.dataDelete",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "9_reveal@2"
        },
        {
          "command": "pyneide.workspace.openOutputChart",
          "when": "view == pyneide.workspace && viewItem == pyneChartOutput",
          "group": "inline@1"
        },
        {
          "command": "pyneide.workspace.openOutputChart",
          "when": "view == pyneide.workspace && viewItem == pyneChartOutput",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.workspace.revealInExplorer",
          "when": "view == pyneide.workspace && (viewItem == pyneOutput || viewItem == pyneChartOutput)",
          "group": "9_reveal@1"
        },
        {
          "command": "pyneide.outputDelete",
          "when": "view == pyneide.workspace && (viewItem == pyneOutput || viewItem == pyneChartOutput)",
          "group": "9_reveal@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pyneide.workspace.deleteSelected",
        "key": "delete",
        "mac": "backspace",
        "when": "focusedView == pyneide.workspace"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pyneide",
          "title": "Pyne",
          "icon": "./icons/pyne-view.svg"
        }
      ]
    },
    "views": {
      "pyneide": [
        {
          "id": "pyneide.workspace",
          "name": "Workspace",
          "icon": "./icons/pyne-view.svg",
          "contextualTitle": "Pyne"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pyneide.workspace",
        "when": "!pyneide.hasWorkdir",
        "contents": "No Pyne workspace found in this folder.\n[Initialize Pyne Project](command:pyneide.createWorkspace)\n[Get Started](command:pyneide.openWalkthrough)"
      }
    ],
    "walkthroughs": [
      {
        "id": "pyneide.gettingStarted",
        "title": "Get Started with PyneIDE",
        "description": "Set up the runtime, scaffold a project, and run your first indicator or strategy on a real chart — then step through it bar by bar.",
        "featuredFor": [
          "**/*.pine",
          "**/*.psc"
        ],
        "steps": [
          {
            "id": "environment",
            "title": "Set up the Pyne runtime",
            "description": "PyneIDE brings its own Python. It downloads uv, Python and the PyneCore runtime into extension storage — no system Python, no Microsoft Python extension, nothing to configure.\nIt offers this by itself the first time you need it, or you can start it now.\n[Set Up Environment](command:pyneide.setupEnvironment)",
            "media": {
              "svg": "media/walkthrough/environment.svg",
              "altText": "A VS Code window with a notification showing the one-time environment setup progress, and the PyneIDE status bar item."
            },
            "completionEvents": [
              "onContext:pyneide.envReady",
              "onCommand:pyneide.setupEnvironment"
            ]
          },
          {
            "id": "project",
            "title": "Initialize a Pyne project",
            "description": "Scaffold a workdir with a runnable demo script and sample data. Scripts, data, outputs and plugins all appear in the Pyne view in the Activity Bar.\n[Initialize Pyne Project](command:pyneide.createWorkspace)",
            "media": {
              "svg": "media/walkthrough/project.svg",
              "altText": "The Pyne view in the Activity Bar with Scripts, Data, Outputs and Plugins sections and a scaffolded demo script."
            },
            "completionEvents": [
              "onContext:pyneide.hasWorkdir",
              "onCommand:pyneide.createWorkspace"
            ]
          },
          {
            "id": "run",
            "title": "Run it on a chart",
            "description": "Open a script and press Run above its entry point, or use the Run action in the Pyne view. The run streams onto a candlestick chart with faithful Pine plots; strategies also get trade markers, an equity curve and Trades / Stats tables.\n[Open the Pyne View](command:workbench.view.extension.pyneide)",
            "media": {
              "svg": "media/walkthrough/run.svg",
              "altText": "A script in the editor next to a candlestick chart with an overlay plot, volume bars and a results table."
            },
            "completionEvents": [
              "onCommand:pyneide.runScript",
              "onCommand:pyneide.runPineScript",
              "onCommand:pyneide.workspace.runScript",
              "onCommand:pyneide.workspace.runPineScript"
            ]
          },
          {
            "id": "debug",
            "title": "Debug it bar by bar",
            "description": "Set a breakpoint in your Pine or Pyne file and press Debug. Step line by line or bar by bar, inspect the current bar's OHLCV in the Pyne scope, and watch series history such as close[1] — in Pine terms, not the generated Python.\n[Open the Pyne View](command:workbench.view.extension.pyneide)",
            "media": {
              "svg": "media/walkthrough/debug.svg",
              "altText": "A paused debug session: a breakpoint in the editor gutter, the debug toolbar with a next-bar action, the paused bar marked on the chart, and the Pyne scope showing close and close[1]."
            },
            "completionEvents": [
              "onCommand:pyneide.debugScript",
              "onCommand:pyneide.debugPineScript",
              "onCommand:pyneide.workspace.debugScript",
              "onCommand:pyneide.workspace.debugPineScript"
            ]
          },
          {
            "id": "script",
            "title": "Write your own script",
            "description": "Create an indicator, strategy or library — as Pine Script (.pine) or as Pyne code (a @pyne .py file). Both run on the same PyneCore runtime, and libraries land in the TradingView-compatible versioned layout.\n[New Script…](command:pyneide.workspace.createScript)",
            "media": {
              "svg": "media/walkthrough/script.svg",
              "altText": "The New Script quick pick listing Pine and Pyne indicator, strategy and library templates."
            },
            "completionEvents": [
              "onCommand:pyneide.workspace.createScript"
            ]
          },
          {
            "id": "data",
            "title": "Bring your own market data",
            "description": "Search symbols across providers and download OHLCV data into the workdir, then inspect it in a read-only table or preview it on a chart. The Symbol Map points request.security() at the right source.\n[Download Data…](command:pyneide.dataDownloadWizard)\n[Open Symbol Browser](command:pyneide.openSymbolBrowser)",
            "media": {
              "svg": "media/walkthrough/data.svg",
              "altText": "The Symbol Browser searching for BTC across providers, with a download in progress into the workdir."
            },
            "completionEvents": [
              "onCommand:pyneide.dataDownloadWizard",
              "onCommand:pyneide.openSymbolBrowser"
            ]
          },
          {
            "id": "pine",
            "title": "Compile Pine Script",
            "description": "Running a .pine file compiles it through the PyneSys cloud compiler and caches the result, so unchanged scripts never re-compile. That needs a PyneSys API key; Pyne code runs locally without one. Older sources get a free v4/v5 to v6 conversion.\n[Sign In to PyneSys](command:pyneide.signIn)",
            "media": {
              "svg": "media/walkthrough/pine.svg",
              "altText": "A .pine file compiled through the PyneSys cloud compiler into a chart, with the API key input below."
            },
            "completionEvents": [
              "onContext:pyneide.signedIn",
              "onCommand:pyneide.signIn",
              "onCommand:pyneide.compilePine"
            ]
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "python"
      },
      {
        "language": "pine"
      }
    ],
    "debuggers": [
      {
        "type": "pyne",
        "label": "Pyne",
        "languages": [
          "python",
          "pine"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "script": {
                "type": "string",
                "description": "Pyne (.py) or Pine (.pine) script to debug. Defaults to the active editor.",
                "default": "${file}"
              },
              "data": {
                "type": "string",
                "description": "OHLCV data file (bare name resolves in <workdir>/data). When omitted, the data picker opens."
              },
              "justMyCode": {
                "type": "boolean",
                "description": "Restrict debugging to the script's own code (PyneCore internals are stepped over). Overrides the pyneide.debug.justMyCode setting."
              },
              "variablePresentation": {
                "type": "object",
                "description": "debugpy variable presentation (all/special/function/class/protected -> group | inline | hide). PyneIDE defaults to grouping everything but the script's own values."
              }
            }
          },
          "attach": {
            "properties": {
              "connect": {
                "type": "object",
                "description": "debugpy endpoint of an already running bridge (host, port). Normally filled in automatically by PyneIDE.",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "number"
                  }
                }
              },
              "justMyCode": {
                "type": "boolean"
              },
              "variablePresentation": {
                "type": "object"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Pyne: Debug Pyne code",
            "description": "Debug the current Pyne/Pine script with the PyneIDE runner",
            "body": {
              "type": "pyne",
              "request": "launch",
              "name": "Debug Pyne code",
              "script": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "configuration": [
      {
        "id": "pyneide.general",
        "title": "General",
        "order": 1,
        "properties": {
          "pyneide.workdir": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "order": 1,
            "markdownDescription": "Path to the Pyne workdir, relative to the workspace folder (`.` = the folder itself) or absolute. When empty, PyneIDE searches upward for a directory named `workdir` (pynecore behavior)."
          },
          "pyneide.strictCompile": {
            "type": "boolean",
            "default": false,
            "scope": "resource",
            "order": 2,
            "markdownDescription": "Use strict compilation mode (Pine-exact block scoping; less readable but more compatible output)."
          },
          "pyneide.run.revealOutputOnLog": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "order": 3,
            "markdownDescription": "Reveal the **PyneIDE Run** output channel the first time a run writes a log line, so `log.info()` output is not buried under the other channels. The editor keeps the focus; turn off to never switch automatically."
          },
          "pyneide.debug.justMyCode": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "order": 4,
            "markdownDescription": "Debug only the script's own code: stepping stays out of PyneCore and standard-library internals. Turn off to step into PyneCore itself."
          },
          "pyneide.chart.candleStyle": {
            "type": "string",
            "default": "candles",
            "enum": [
              "candles",
              "hollow",
              "bars",
              "mono",
              "line",
              "area"
            ],
            "enumDescriptions": [
              "Filled candles, up/down colored.",
              "Rising candles hollow, falling filled.",
              "OHLC bars: open tick left, close tick right.",
              "Hollow candles in the editor foreground color.",
              "Closing price as a plain line.",
              "Closing price as a filled area."
            ],
            "scope": "window",
            "order": 5,
            "markdownDescription": "How price is drawn on the chart. The chart toolbar's **Chart style** button writes this setting, so a pick made there is remembered and applies to every chart."
          },
          "pyneide.reportProblem.includeLogs": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "order": 6,
            "markdownDescription": "Attach the recent output-channel logs to a **Report a Problem** submission. Paths and credential-shaped strings are removed before sending; nothing is ever sent without an explicit confirmation."
          }
        }
      },
      {
        "id": "pyneide.codeIntelligence",
        "title": "Code Intelligence",
        "order": 2,
        "properties": {
          "pyneide.checker.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "order": 1,
            "markdownDescription": "Enable the Pyne script checker (structure diagnostics for `@pyne` scripts: `main()` presence, `@script` decorator, Series/Persistent scope rules, request.security constraints). For `@pyne edge` scripts it also enforces the strict Pyne Edge profile (import whitelist, allowed language subset)."
          },
          "pyneide.pyright.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "order": 2,
            "markdownDescription": "Run the bundled pyright language server for Python files in Pyne workspaces (typing diagnostics without Pylance). Automatically stays off when Pylance, Pyright or BasedPyright is installed."
          },
          "pyneide.pineLs.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "Enable the Pine language server (diagnostics, completion, navigation for `.pine` files). Uses a signed native binary installed into extension storage."
          },
          "pyneide.pineLs.autoUpdate": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "order": 4,
            "markdownDescription": "Check for Pine language server updates in the background (at most once a day). Updates install atomically; the previous version is kept for rollback."
          }
        }
      },
      {
        "id": "pyneide.environment",
        "title": "Environment",
        "order": 3,
        "properties": {
          "pyneide.pythonPath": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 1,
            "markdownDescription": "Path to a Python interpreter to use instead of the managed environment. PyneIDE does not install packages into it, only checks that `pynesys-pynecore` and `debugpy` are available."
          },
          "pyneide.venvPath": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 2,
            "markdownDescription": "Path to a virtualenv directory to use instead of the managed environment. Takes precedence over `#pyneide.pythonPath#`. PyneIDE does not install packages into it."
          }
        }
      },
      {
        "id": "pyneide.development",
        "title": "Development",
        "order": 99,
        "properties": {
          "pyneide.useOwnPynecore": {
            "type": "boolean",
            "default": false,
            "scope": "machine",
            "included": false,
            "markdownDescription": "Development override, hidden from the Settings UI. Keep an already installed (e.g. editable/development) PyneCore in the managed environment instead of the pinned version; only a minimum-version check is performed."
          },
          "pyneide.apiBaseUrl": {
            "type": "string",
            "default": "https://api.pynesys.io",
            "scope": "machine",
            "included": false,
            "markdownDescription": "Development override, hidden from the Settings UI. Base URL of the PyneSys API. Machine-scoped on purpose: a workspace must not be able to redirect your API key to another host."
          },
          "pyneide.pineLs.path": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "included": false,
            "markdownDescription": "Development override, hidden from the Settings UI. Path to a Pine language server executable to use instead of the managed install. Signature verification and auto-update are skipped for it."
          },
          "pyneide.pineLs.baseUrl": {
            "type": "string",
            "default": "https://pine-ls.pynesys.io",
            "scope": "machine",
            "included": false,
            "markdownDescription": "Development override, hidden from the Settings UI. Base URL of the Pine language server release site. Every download must verify against the Ed25519 release key built into PyneIDE, so this cannot be used to inject binaries."
          }
        }
      }
    ],
    "languages": [
      {
        "id": "pine",
        "aliases": [
          "Pine Script",
          "pine",
          "pinescript"
        ],
        "extensions": [
          ".pine",
          ".psc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pine-file.svg",
          "dark": "./icons/pine-file.svg"
        }
      },
      {
        "id": "toml",
        "aliases": [
          "TOML"
        ],
        "extensions": [
          ".toml"
        ],
        "filenames": [
          "Cargo.lock",
          "Gopkg.lock",
          "Pipfile",
          "poetry.lock",
          "uv.lock"
        ],
        "configuration": "./language-configuration-toml.json"
      },
      {
        "id": "json",
        "filenamePatterns": [
          "*.py.map"
        ]
      }
    ],
    "grammars": [
      {
        "language": "pine",
        "scopeName": "source.pine",
        "path": "./syntaxes/pine.tmLanguage.json"
      },
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./syntaxes/toml.tmLanguage.json"
      },
      {
        "scopeName": "pyne.injection",
        "path": "./syntaxes/pyne.injection.json",
        "injectTo": [
          "source.python"
        ]
      }
    ],
    "snippets": [
      {
        "language": "pine",
        "path": "./snippets/pine.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "pyneide.ohlcvTable",
        "displayName": "OHLCV Table",
        "selector": [
          {
            "filenamePattern": "*.ohlcv"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test:grammar": "npm run test:grammar:pine && npm run test:grammar:pyne",
    "test:grammar:pine": "vscode-tmgrammar-snap test/grammar/*.pine",
    "test:grammar:pyne": "vscode-tmgrammar-snap -g test/grammar/vendor/MagicPython.tmLanguage.json -s source.python test/grammar/*.py",
    "test:grammar:update": "npm run test:grammar:pine:update && npm run test:grammar:pyne:update",
    "test:grammar:pine:update": "vscode-tmgrammar-snap --updateSnapshot test/grammar/*.pine",
    "test:grammar:pyne:update": "vscode-tmgrammar-snap --updateSnapshot -g test/grammar/vendor/MagicPython.tmLanguage.json -s source.python test/grammar/*.py",
    "test:env": "node esbuild.mjs --smoke && node dist/env-smoke.js",
    "test:pinels": "node esbuild.mjs --smoke-pinels && node dist/pinels-smoke.js",
    "test:pyright": "node esbuild.mjs --smoke-pyright && node dist/pyright-smoke.js",
    "test:checker": "node esbuild.mjs --smoke-checker && node dist/checker-smoke.js",
    "test:edge-corpus": "node esbuild.mjs --smoke-edge-corpus && node dist/edge-corpus-smoke.js",
    "test:bridge-viz": "node esbuild.mjs --smoke-bridge-viz && node dist/bridge-viz-smoke.js",
    "test:bridge-security": "node esbuild.mjs --smoke-bridge-security && node dist/bridge-security-smoke.js",
    "test:chart-breakpoints": "node esbuild.mjs --smoke-chart-breakpoints && node dist/chart-breakpoint-condition-smoke.js",
    "test:library-imports": "node esbuild.mjs --smoke-library-imports && node dist/library-imports-smoke.js",
    "test:symbol-map": "node esbuild.mjs --smoke-symbol-map && node dist/symbol-map-smoke.js",
    "test:report": "node esbuild.mjs --smoke-report && node dist/report-smoke.js",
    "test:plugins": "node esbuild.mjs --smoke-plugins && node dist/plugins-smoke.js",
    "vscode:prepublish": "npm run build",
    "prepackage": "node -e \"require('fs').mkdirSync('build',{recursive:true})\"",
    "package": "vsce package --out build/"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.3.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "@vscode/vsce-sign@2.0.9": true,
    "keytar@7.9.0": true
  },
  "dependencies": {
    "klinecharts": "^10.0.0",
    "pyright": "1.1.411",
    "vscode-languageclient": "^9.0.1"
  }
}
