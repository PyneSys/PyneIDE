{
  "name": "pyneide",
  "displayName": "PyneIDE",
  "description": "Pine Script and Pyne language support: syntax highlighting for .pine files and Pyne script detection. Pine Script is a trademark of TradingView; PyneIDE is not a TradingView product and is not affiliated with TradingView.",
  "version": "0.0.1",
  "preview": true,
  "publisher": "pynesys",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "pine script",
    "pinescript",
    "pyne",
    "pynecore",
    "trading",
    "indicators",
    "strategies",
    "backtesting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PyneSys/PyneIDE"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:pine",
    "onDebugDynamicConfigurations:pyne",
    "onCustomEditor:pyneide.ohlcvTable"
  ],
  "contributes": {
    "configurationDefaults": {
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.patterns": {
        "*.pine": "${capture}.py, ${capture}.py.map, ${capture}.toml",
        "*.py": "${capture}.py.map, ${capture}.toml",
        "*.ohlcv": "${capture}.toml"
      }
    },
    "commands": [
      {
        "command": "pyneide.setupEnvironment",
        "title": "Setup Environment",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.createWorkspace",
        "title": "Initialize Pyne Project",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.showEnvironmentLog",
        "title": "Show Environment Log",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.environmentMenu",
        "title": "Environment Menu",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.signIn",
        "title": "Sign In to PyneSys",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.signOut",
        "title": "Sign Out from PyneSys",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pineLsInstall",
        "title": "Install / Update Pine Language Server",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pineLsRestart",
        "title": "Restart Pine Language Server",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pineLsShowLog",
        "title": "Show Pine Language Server Log",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pyrightRestart",
        "title": "Restart Pyne Typing (pyright)",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.pyrightShowLog",
        "title": "Show Pyne Typing Log",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.compilePine",
        "title": "Compile Pine Script",
        "category": "PyneIDE",
        "enablement": "editorLangId == pine"
      },
      {
        "command": "pyneide.convertToV6",
        "title": "Convert Pine to v6",
        "category": "PyneIDE",
        "enablement": "editorLangId == pine"
      },
      {
        "command": "pyneide.showUsage",
        "title": "Show API Usage",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.toggleStrictCompile",
        "title": "Toggle Strict Compilation",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.runScript",
        "title": "Run Pyne code",
        "category": "PyneIDE",
        "icon": "$(play)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      },
      {
        "command": "pyneide.debugScript",
        "title": "Debug Pyne code",
        "category": "PyneIDE",
        "icon": "$(debug-alt)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      },
      {
        "command": "pyneide.changeRunData",
        "title": "Select Data…",
        "category": "PyneIDE",
        "icon": "$(graph-line)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      },
      {
        "command": "pyneide.openChart",
        "title": "Open Chart",
        "category": "PyneIDE",
        "icon": "$(graph)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      },
      {
        "command": "pyneide.toggleChartFullscreen",
        "title": "Toggle Chart Fullscreen",
        "category": "PyneIDE",
        "icon": "$(screen-full)"
      },
      {
        "command": "pyneide.pauseRun",
        "title": "Pause Run at Next Bar",
        "category": "PyneIDE",
        "enablement": "pyneide.runActive && !pyneide.runPaused"
      },
      {
        "command": "pyneide.resumeRun",
        "title": "Resume Run",
        "category": "PyneIDE",
        "enablement": "pyneide.runPaused"
      },
      {
        "command": "pyneide.stepBar",
        "title": "Next Bar",
        "category": "PyneIDE",
        "icon": "$(triangle-right)",
        "enablement": "pyneide.runActive"
      },
      {
        "command": "pyneide.runToBar",
        "title": "Run to Bar…",
        "category": "PyneIDE",
        "icon": "$(run-below)",
        "enablement": "pyneide.runActive"
      },
      {
        "command": "pyneide.cancelRun",
        "title": "Cancel Run",
        "category": "PyneIDE",
        "enablement": "pyneide.runActive"
      },
      {
        "command": "pyneide.runControlMenu",
        "title": "Run Controls",
        "category": "PyneIDE",
        "enablement": "pyneide.runActive"
      },
      {
        "command": "pyneide.workspace.refresh",
        "title": "Refresh",
        "category": "PyneIDE",
        "icon": "$(refresh)"
      },
      {
        "command": "pyneide.dataDownloadWizard",
        "title": "Download Data…",
        "category": "PyneIDE",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pyneide.openSymbolBrowser",
        "title": "Open Symbol Browser",
        "category": "PyneIDE",
        "icon": "$(search)"
      },
      {
        "command": "pyneide.workspace.runScript",
        "title": "Run Pyne code",
        "category": "PyneIDE",
        "icon": "$(play)"
      },
      {
        "command": "pyneide.workspace.debugScript",
        "title": "Debug Pyne code",
        "category": "PyneIDE",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pyneide.workspace.selectData",
        "title": "Select Data…",
        "category": "PyneIDE",
        "icon": "$(graph-line)"
      },
      {
        "command": "pyneide.workspace.openTable",
        "title": "Open as Table",
        "category": "PyneIDE",
        "icon": "$(table)"
      },
      {
        "command": "pyneide.dataUpdate",
        "title": "Update (continue)",
        "category": "PyneIDE",
        "icon": "$(sync)"
      },
      {
        "command": "pyneide.dataTruncate",
        "title": "Truncate & Re-download…",
        "category": "PyneIDE",
        "icon": "$(trash)"
      },
      {
        "command": "pyneide.dataPreviewChart",
        "title": "Preview Chart",
        "category": "PyneIDE",
        "icon": "$(graph)"
      },
      {
        "command": "pyneide.dataDelete",
        "title": "Delete Data…",
        "category": "PyneIDE",
        "icon": "$(trash)"
      },
      {
        "command": "pyneide.outputDelete",
        "title": "Delete",
        "category": "PyneIDE",
        "icon": "$(trash)"
      },
      {
        "command": "pyneide.workspace.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "PyneIDE"
      },
      {
        "command": "pyneide.editInputs",
        "title": "Edit Inputs…",
        "category": "PyneIDE",
        "icon": "$(settings-gear)",
        "enablement": "pyneide.isPyneScript || resourceLangId == pine"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pyneide.compilePine",
          "when": "resourceLangId == pine",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.convertToV6",
          "when": "resourceLangId == pine",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.runScript",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "pyneide@0"
        },
        {
          "command": "pyneide.debugScript",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "pyneide@2"
        },
        {
          "command": "pyneide.changeRunData",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "pyneide@3"
        },
        {
          "command": "pyneide.openChart",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "pyneide@4"
        },
        {
          "command": "pyneide.editInputs",
          "when": "pyneide.isPyneScript",
          "group": "pyneide@5"
        }
      ],
      "editor/title/run": [
        {
          "command": "pyneide.runScript",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "navigation@1"
        },
        {
          "command": "pyneide.debugScript",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "pyneide.openChart",
          "when": "resourceLangId == pine || pyneide.isPyneScript",
          "group": "navigation@1"
        },
        {
          "command": "pyneide.editInputs",
          "when": "pyneide.isPyneScript",
          "group": "navigation@3"
        },
        {
          "command": "pyneide.toggleChartFullscreen",
          "when": "activeWebviewPanelId == pyneideChart && !editorPartMaximizedEditorGroup",
          "group": "navigation@-100"
        }
      ],
      "debug/toolBar": [
        {
          "command": "pyneide.stepBar",
          "when": "debugType == pyne && pyneide.runActive",
          "group": "navigation@1"
        },
        {
          "command": "pyneide.runToBar",
          "when": "debugType == pyne && pyneide.runActive",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "pyneide.workspace.refresh",
          "when": "view == pyneide.workspace",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "pyneide.dataDownloadWizard",
          "when": "view == pyneide.workspace && viewItem == pyneSection.data",
          "group": "inline@1"
        },
        {
          "command": "pyneide.dataDownloadWizard",
          "when": "view == pyneide.workspace && viewItem == pyneSection.data",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.workspace.runScript",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "inline@1"
        },
        {
          "command": "pyneide.workspace.debugScript",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "inline@2"
        },
        {
          "command": "pyneide.workspace.runScript",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.workspace.debugScript",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "pyneide@2"
        },
        {
          "command": "pyneide.workspace.selectData",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "pyneide@3"
        },
        {
          "command": "pyneide.editInputs",
          "when": "view == pyneide.workspace && viewItem == pyneScript",
          "group": "pyneide@4"
        },
        {
          "command": "pyneide.workspace.revealInExplorer",
          "when": "view == pyneide.workspace && (viewItem == pyneScript || viewItem == pyneFile)",
          "group": "9_reveal@1"
        },
        {
          "command": "pyneide.dataPreviewChart",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "inline@1"
        },
        {
          "command": "pyneide.dataUpdate",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "inline@2"
        },
        {
          "command": "pyneide.dataPreviewChart",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "pyneide@1"
        },
        {
          "command": "pyneide.workspace.openTable",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "pyneide@2"
        },
        {
          "command": "pyneide.dataUpdate",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "pyneide@3"
        },
        {
          "command": "pyneide.dataTruncate",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "pyneide@4"
        },
        {
          "command": "pyneide.workspace.revealInExplorer",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "9_reveal@1"
        },
        {
          "command": "pyneide.dataDelete",
          "when": "view == pyneide.workspace && viewItem == pyneData",
          "group": "9_reveal@2"
        },
        {
          "command": "pyneide.workspace.revealInExplorer",
          "when": "view == pyneide.workspace && viewItem == pyneOutput",
          "group": "9_reveal@1"
        },
        {
          "command": "pyneide.outputDelete",
          "when": "view == pyneide.workspace && viewItem == pyneOutput",
          "group": "9_reveal@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pyneide.workspace.deleteSelected",
        "key": "delete",
        "mac": "backspace",
        "when": "focusedView == pyneide.workspace"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pyneide",
          "title": "Pyne",
          "icon": "./icons/pyne-view.svg"
        }
      ]
    },
    "views": {
      "pyneide": [
        {
          "id": "pyneide.workspace",
          "name": "Workspace",
          "icon": "./icons/pyne-view.svg",
          "contextualTitle": "Pyne"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pyneide.workspace",
        "when": "!pyneide.hasWorkdir",
        "contents": "No Pyne workspace found in this folder.\n[Initialize Pyne Project](command:pyneide.createWorkspace)"
      }
    ],
    "breakpoints": [
      {
        "language": "python"
      },
      {
        "language": "pine"
      }
    ],
    "debuggers": [
      {
        "type": "pyne",
        "label": "Pyne",
        "languages": [
          "python",
          "pine"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "script": {
                "type": "string",
                "description": "Pyne (.py) or Pine (.pine) script to debug. Defaults to the active editor.",
                "default": "${file}"
              },
              "data": {
                "type": "string",
                "description": "OHLCV data file (bare name resolves in <workdir>/data). When omitted, the data picker opens."
              },
              "justMyCode": {
                "type": "boolean",
                "description": "Restrict debugging to the script's own code (PyneCore internals are stepped over). Overrides the pyneide.debug.justMyCode setting."
              },
              "variablePresentation": {
                "type": "object",
                "description": "debugpy variable presentation (all/special/function/class/protected -> group | inline | hide). PyneIDE defaults to grouping everything but the script's own values."
              }
            }
          },
          "attach": {
            "properties": {
              "connect": {
                "type": "object",
                "description": "debugpy endpoint of an already running bridge (host, port). Normally filled in automatically by PyneIDE.",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "number"
                  }
                }
              },
              "justMyCode": {
                "type": "boolean"
              },
              "variablePresentation": {
                "type": "object"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Pyne: Debug Pyne code",
            "description": "Debug the current Pyne/Pine script with the PyneIDE runner",
            "body": {
              "type": "pyne",
              "request": "launch",
              "name": "Debug Pyne code",
              "script": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "PyneIDE",
      "properties": {
        "pyneide.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to a Python interpreter to use instead of the managed environment. PyneIDE does not install packages into it, only checks that `pynesys-pynecore` and `debugpy` are available."
        },
        "pyneide.venvPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to a virtualenv directory to use instead of the managed environment. Takes precedence over `#pyneide.pythonPath#`. PyneIDE does not install packages into it."
        },
        "pyneide.useOwnPynecore": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Keep an already installed (e.g. editable/development) PyneCore in the managed environment instead of the pinned version; only a minimum-version check is performed."
        },
        "pyneide.apiBaseUrl": {
          "type": "string",
          "default": "https://api.pynesys.io",
          "scope": "machine",
          "markdownDescription": "Base URL of the PyneSys API. Machine-scoped on purpose: a workspace must not be able to redirect your API key to another host."
        },
        "pyneide.workdir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to the Pyne workdir, relative to the workspace folder (`.` = the folder itself) or absolute. When empty, PyneIDE searches upward for a directory named `workdir` (pynecore behavior)."
        },
        "pyneide.strictCompile": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Use strict compilation mode (Pine-exact block scoping; less readable but more compatible output)."
        },
        "pyneide.promptInputs": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Open the input form before running a Pyne script, so its inputs can be reviewed and edited first. When off, runs use the values already saved in the script's `.toml`."
        },
        "pyneide.debug.justMyCode": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Debug only the script's own code: stepping stays out of PyneCore and standard-library internals. Turn off to step into PyneCore itself."
        },
        "pyneide.pyright.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Run the bundled pyright language server for Python files in Pyne workspaces (typing diagnostics without Pylance). Automatically stays off when Pylance, Pyright or BasedPyright is installed."
        },
        "pyneide.checker.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Enable the Pyne script checker (structure diagnostics for `@pyne` scripts: `main()` presence, `@script` decorator, Series/Persistent scope rules, request.security constraints). For `@pyne edge` scripts it also enforces the strict Pyne Edge profile (import whitelist, allowed language subset)."
        },
        "pyneide.pineLs.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Enable the Pine language server (diagnostics, completion, navigation for `.pine` files). Uses a signed native binary installed into extension storage."
        },
        "pyneide.pineLs.autoUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Check for Pine language server updates in the background (at most once a day). Updates install atomically; the previous version is kept for rollback."
        },
        "pyneide.pineLs.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to a Pine language server executable to use instead of the managed install (development override). Signature verification and auto-update are skipped for it."
        },
        "pyneide.pineLs.baseUrl": {
          "type": "string",
          "default": "https://pine-ls.pynesys.io",
          "scope": "machine",
          "markdownDescription": "Base URL of the Pine language server release site. Every download must verify against the Ed25519 release key built into PyneIDE, so this cannot be used to inject binaries."
        }
      }
    },
    "languages": [
      {
        "id": "pine",
        "aliases": [
          "Pine Script",
          "pine",
          "pinescript"
        ],
        "extensions": [
          ".pine",
          ".psc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pine-file.svg",
          "dark": "./icons/pine-file.svg"
        }
      },
      {
        "id": "toml",
        "aliases": [
          "TOML"
        ],
        "extensions": [
          ".toml"
        ],
        "filenames": [
          "Cargo.lock",
          "Gopkg.lock",
          "Pipfile",
          "poetry.lock",
          "uv.lock"
        ],
        "configuration": "./language-configuration-toml.json"
      },
      {
        "id": "json",
        "filenamePatterns": [
          "*.py.map"
        ]
      }
    ],
    "grammars": [
      {
        "language": "pine",
        "scopeName": "source.pine",
        "path": "./syntaxes/pine.tmLanguage.json"
      },
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./syntaxes/toml.tmLanguage.json"
      },
      {
        "scopeName": "pyne.injection",
        "path": "./syntaxes/pyne.injection.json",
        "injectTo": [
          "source.python"
        ]
      }
    ],
    "snippets": [
      {
        "language": "pine",
        "path": "./snippets/pine.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "pyneide.ohlcvTable",
        "displayName": "OHLCV Table",
        "selector": [
          {
            "filenamePattern": "*.ohlcv"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test:grammar": "npm run test:grammar:pine && npm run test:grammar:pyne",
    "test:grammar:pine": "vscode-tmgrammar-snap test/grammar/*.pine",
    "test:grammar:pyne": "vscode-tmgrammar-snap -g test/grammar/vendor/MagicPython.tmLanguage.json -s source.python test/grammar/*.py",
    "test:grammar:update": "npm run test:grammar:pine:update && npm run test:grammar:pyne:update",
    "test:grammar:pine:update": "vscode-tmgrammar-snap --updateSnapshot test/grammar/*.pine",
    "test:grammar:pyne:update": "vscode-tmgrammar-snap --updateSnapshot -g test/grammar/vendor/MagicPython.tmLanguage.json -s source.python test/grammar/*.py",
    "test:env": "node esbuild.mjs --smoke && node dist/env-smoke.js",
    "test:pinels": "node esbuild.mjs --smoke-pinels && node dist/pinels-smoke.js",
    "test:pyright": "node esbuild.mjs --smoke-pyright && node dist/pyright-smoke.js",
    "test:checker": "node esbuild.mjs --smoke-checker && node dist/checker-smoke.js",
