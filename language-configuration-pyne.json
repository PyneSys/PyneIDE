{
  "comments": { "lineComment": "#", "blockComment": ["\"\"\"", "\"\"\""] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "folding": {
    "offSide": true,
    "markers": { "start": "^\\s*#\\s*region\\b", "end": "^\\s*#\\s*endregion\\b" }
  },
  "onEnterRules": [{
    "beforeText": "^\\s*(?:async\\s+)?(?:def|class|for|if|elif|else|while|try|with|finally|except|match|case)\\b.*:\\s*(?:#.*)?$",
    "action": { "indent": "indent" }
  }]
}
